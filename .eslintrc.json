{
  "root": true,
  "env": {
    "browser": true,
    "es2022": true
  },
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "script"
  },
  "extends": ["eslint:recommended"],
  "globals": {
    "Engine": "readonly",
    "Sk": "readonly"
  },
  "rules": {
    "no-unused-vars": ["error", { "args": "none", "caughtErrors": "none" }],
    "no-constant-condition": ["error", { "checkLoops": false }],
    "no-empty": ["error", { "allowEmptyCatch": true }]
  },
  "ignorePatterns": [
    "node_modules/",
    "assets/",
    "img/"
  ],
  "overrides": [
    {
      "files": ["server/**/*.js", "tests/**/*.js"],
      "env": {
        "node": true,
        "browser": true
      },
      "parserOptions": {
        "sourceType": "module"
      }
    }
  ]
}
