# Copia a .env y ajusta (el servidor lee el entorno, no este archivo)
PORT=3001
SQLITE_PATH=./devquest.db
JWT_SECRET=cambia-esto-por-uno-largo-y-aleatorio
JWT_EXPIRES_SECONDS=604800
RESET_TOKEN_HOURS=1
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
# ── Email ──
# Los mensajes del formulario de contacto se guardan SIEMPRE en la base de
# datos (tabla contact_messages). Para que además salga un email a tu buzón,
# define SMTP_HOST o RESEND_API_KEY. Sin ninguno de los dos, funciona igual:
# guarda el mensaje y devuelve un aviso.
#
# Opción A: SMTP (Gmail, Outlook, tu servidor...)
SMTP_HOST=
SMTP_PORT=587
# Gmail necesita "aplicaciones con contraseña": cuenta>seguridad>2 pasos
SMTP_USER=
SMTP_PASS=
# Ponlo a false si usas un servidor local sin TLS
SMTP_TLS=true
SMTP_FROM=DevQuest <no-reply@devquest.local>
#
# Opción B: API de transactional (más simple que SMTP)
# RESEND_API_KEY=re_xxxxxxxxxxxx
#
# A quién llegan los mensajes del formulario
CONTACT_TO=duckdev77@gmail.com
#
# Para leer los mensajes con GET /api/contact (opcional, separado por comas)
ADMIN_IDS=
PUBLIC_BASE_URL=http://localhost:3000
# Futuro Postgres:
# DATABASE_URL=postgres://devquest:devquest@localhost:5432/devquest
